{
  "name": "publa",
  "version": "0.1.47",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "tag-version-prefix": "release-v"
  },
  "scripts": {
    "test:unit": "npm run db:check-migrations && vitest --watch=false",
    "test:pg": "npm run db:check-migrations && vitest run src/server/services/postgres.contract.test.ts",
    "test:e2e": "NEXT_PUBLIC_E2E=1 next build && NEXT_PUBLIC_E2E=1 playwright test",
    "test": "npm run lint && npm run test:unit && npm run test:e2e",
    "dev": "next dev -p 8084",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ./src ./e2e --max-warnings 0",
    "lint:fix": "eslint ./src ./e2e --fix --max-warnings 0",
    "db:generate": "npm run db:generate:sqlite",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:generate:all": "npm run db:generate:sqlite && npm run db:generate:pg",
    "db:migrate": "npm run db:migrate:sqlite",
    "db:migrate:sqlite": "drizzle-kit migrate --config=drizzle.sqlite.config.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.pg.config.ts",
    "db:check-migrations": "node scripts/check-migration-chain.mjs",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.sqlite.config.ts",
    "check:i18n-runtime": "node scripts/check-i18n-runtime.mjs",
    "check:error-leaks": "node scripts/check-api-message-leaks.mjs",
    "check:ci-guard": "npm run check:i18n-runtime && npm run check:error-leaks",
    "version": "node scripts/sync-version.mjs && git add src/version.json"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@tiptap/core": "$@tiptap/core",
    "@tiptap/extension-mathematics": {
      "katex": "$katex"
    },
    "minimatch@^10.0.0": "11.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.18.0",
    "@mantine/charts": "^9.8.0",
    "@mantine/core": "^9.8.0",
    "@mantine/dates": "^9.8.0",
    "@mantine/dropzone": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/modals": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@mantine/tiptap": "^9.8.0",
    "@tabler/icons-react": "^3.51.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-code-block-lowlight": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-mathematics": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/turndown": "^5.0.6",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "ahooks": "^3.11.0",
    "ali-oss": "^6.23.0",
    "animate.css": "^4.1.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookies": "^0.9.2",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "feed": "^6.0.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.17",
    "js-base64": "^3.9.6",
    "js-cookie": "^3.0.8",
    "katex": "^0.19.1",
    "lodash": "^4.18.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.70.0",
    "markdown-it": "^15.0.3",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-mathjax": "^2.0.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.6",
    "next-intl": "^4.14.9",
    "nextjs-progressbar": "^0.0.16",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "postcss-preset-mantine": "^1.18.0",
    "qs": "^6.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.21",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "svg-captcha": "^1.4.0",
    "sweetalert2": "^11.26.25",
    "toad-scheduler": "^4.2.0",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.65.0",
    "@types/ali-oss": "^6.23.4",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
